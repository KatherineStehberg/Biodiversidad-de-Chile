# ==================================================
# Application
# ==================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Requerido por NextAuth en tiempo de ejecucion. No aparece como process.env explicito en src/,
# pero next-auth lo exige internamente para firmar sesiones/JWT. Nunca usar un valor funcional aqui.
NEXTAUTH_SECRET=

# ==================================================
# Supabase
# ==================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# true = usa datos mock (sin conexion real a Supabase). Recomendado para desarrollo local.
NEXT_PUBLIC_USE_MOCK_DATA=true

# ==================================================
# Administration and moderation
# ==================================================

# lib/email.ts usa ADMIN_EMAILS primero; si esta vacia, cae a ADMIN_EMAIL (fallback).
# Formato ADMIN_EMAILS: correos separados por coma, ej: admin1@dominio.com,admin2@dominio.com
ADMIN_EMAILS=
ADMIN_EMAIL=
MODERATION_SECRET=
REVALIDATE_SECRET=

# ==================================================
# Email (SMTP - opcional)
# ==================================================

# Si SMTP_HOST, SMTP_PORT, SMTP_USER o SMTP_PASS quedan vacios, lib/email.ts omite el envio
# de correo silenciosamente (no falla, solo hace log). El envio NO funcionara sin las 4 variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==================================================
# Payments (opcional)
# ==================================================

FLOW_CHECKOUT_URL=https://sandbox.example.com/checkout

# ==================================================
# Automation / n8n (opcional)
# ==================================================

# api/diagnostic/route.ts usa N8N_DIAGNOSTIC_WEBHOOK_URL primero; si no esta definida,
# cae a N8N_WEBHOOK_URL como fallback. Si ninguna esta definida, el endpoint responde 500.
N8N_DIAGNOSTIC_WEBHOOK_URL=
N8N_WEBHOOK_URL=

# ==================================================
# Feature flags
# ==================================================

# app/consultores/page.tsx - true muestra tambien ofertas pendientes de aprobacion
OFFERS_SHOW_PENDING=false
# api/offers/route.ts - true exige SMTP configurado antes de permitir publicar ofertas
OFFERS_ENFORCE_SMTP=false
